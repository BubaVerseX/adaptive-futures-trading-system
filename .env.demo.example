# Bybit Demo Trading only.
# Copy this file to .env, then fill in the demo API key/secret created inside Bybit Demo Trading.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_DEMO_TRADING=true
BYBIT_TESTNET=false
DRY_RUN=false
ACKNOWLEDGE_DEMO_TRADING=true
ACKNOWLEDGE_HIGH_LEVERAGE_RISK=true

# Official Bybit Demo Trading endpoints.
BYBIT_REST_BASE_URL=https://api-demo.bybit.com
BYBIT_WS_BASE_URL=
BYBIT_PUBLIC_WS_BASE_URL=wss://stream.bybit.com
BYBIT_PRIVATE_WS_BASE_URL=wss://stream-demo.bybit.com
BYBIT_RECV_WINDOW_MS=5000

# Mainnet live trading must remain disabled for demo validation.
ACKNOWLEDGE_LIVE_TRADING=false

# Existing V4 strategy/risk settings are intentionally left in .env.example.
# The demo launch path uses the same analytics, execution ledger, TP/SL verification,
# fee accounting, and adaptive memory modules with isolated files under data/demo/.
