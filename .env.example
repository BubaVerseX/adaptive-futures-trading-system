# Bybit Unified Trading API V5 credentials.
# Create API keys in testnet first. Never commit a populated .env file.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
# Leave blank to use the standard endpoint selected by BYBIT_TESTNET.
# Mainnet accounts registered in a regional Bybit site may require its official regional API URLs.
BYBIT_REST_BASE_URL=
BYBIT_WS_BASE_URL=
BYBIT_RECV_WINDOW_MS=5000

# Orders are simulated unless DRY_RUN is explicitly false.
DRY_RUN=true
ACCOUNT_START_USDT=100
X10_MODE=true

# Aggressive but less chaotic momentum strategy.
FAST_MODE=true
FOMO_BREAKOUT_MODE=true
MICRO_BREAKOUT_ENTRIES=true
ALLOW_CHOPPY_MARKET=true
ALLOW_PARTIAL_SCAN_ENTRIES=true
ALLOW_LONGS=true
ALLOW_SHORTS=true
MIN_SIGNAL_SCORE=35
AGGRESSIVE_SCORE_THRESHOLD=35

# Exposure, fee efficiency, and daily-loss circuit breaker.
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=60
BASE_RISK_PER_TRADE_PCT=4
AGGRESSIVE_RISK_PER_TRADE_PCT=8
MAX_DAILY_LOSS_PCT=20
MAX_DAILY_LOSS_USDT=20
MAX_LEVERAGE=8
SET_LEVERAGE_ON_ENTRY=true
MAX_POSITION_NOTIONAL_USDT=150
MAX_MARGIN_USAGE_PCT=55
MAX_TOTAL_MARGIN_USAGE_PCT=90
MIN_LIQUIDATION_BUFFER_PCT=2
ESTIMATED_FEE_PCT_PER_SIDE=0.055
MIN_PROJECTED_EDGE_PCT=0.35
SYMBOL_LOSS_COOLDOWN_MINUTES=15
SYMBOL_REENTRY_COOLDOWN_SECONDS=90

# Bybit linear position mode. Set BYBIT_ENSURE_POSITION_MODE=true only if the bot may request this mode for USDT contracts.
BYBIT_POSITION_MODE=ONE_WAY
BYBIT_ENSURE_POSITION_MODE=false

# Fast scanner and REST/WebSocket recovery behavior.
SCAN_INTERVAL_MS=2000
POSITION_MONITOR_INTERVAL_MS=2000
ENTRY_CONFIRMATION_TIMEOUT_MS=15000
SCAN_CONCURRENCY=4
MARKET_REGIME_CACHE_MS=120000
API_REQUEST_INTERVAL_MS=70
API_RATE_LIMIT_COOLDOWN_MS=10000
WS_RECONNECT_BASE_MS=1000
CANDLE_INTERVAL_FAST=1M
CANDLE_INTERVAL_MAIN=5M
CANDLE_INTERVAL_TREND=15M
MAX_SYMBOLS_TO_SCAN=150
MIN_24H_VOLUME_USDT=100000
MAX_SPREAD_PCT=1.50
EXCLUDED_SYMBOLS=
MIN_VOLUME_SPIKE=1.35
MIN_BURST_MOMENTUM_PCT=0.08
FOMO_MOMENTUM_PCT=0.12
MIN_MOMENTUM_PERSISTENCE_CANDLES=2
BTC_TREND_ALIGNMENT_BONUS=8
CHOPPY_MARKET_PENALTY=8
LOW_LIQUIDITY_SPIKE_PENALTY=10

# Adaptive statistical learning. No neural networks, no cloud, only local JSON memory.
ADAPTIVE_LEARNING_ENABLED=true
MIN_ADAPTIVE_TRADES=10
MIN_ADAPTIVE_BUCKET_TRADES=5
ADAPTIVE_MEMORY_MAX_TRADES=5000
DEFENSIVE_WIN_RATE_PCT=35
AGGRESSIVE_WIN_RATE_PCT=60
ADAPTIVE_CONFIDENCE_BONUS_MAX=12
ADAPTIVE_CONFIDENCE_PENALTY_MAX=18
ADAPTIVE_BLACKLIST_WIN_RATE_PCT=25
ADAPTIVE_BLACKLIST_MINUTES=60
ADAPTIVE_RISK_MIN_MULTIPLIER=0.45
ADAPTIVE_RISK_MAX_MULTIPLIER=1.25
HIGH_VOLATILITY_ATR_PCT=0.90
ABNORMAL_VOLATILITY_ATR_PCT=1.80
LOW_VOLUME_MULTIPLE=2

# Native Bybit take-profit/stop-loss plus optional native trailing stop.
TAKE_PROFIT_PCT=1.50
STOP_LOSS_PCT=0.70
TRAILING_STOP_ENABLED=true
TRAILING_START_PCT=0.35
TRAILING_DISTANCE_PCT=0.20

# Shutdown and notifications.
EMERGENCY_STOP_FILE=STOP_BOT.txt
CLOSE_POSITION_ON_EXIT=true
MAX_CONSECUTIVE_API_ERRORS=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required acknowledgements when intentionally sending leveraged or mainnet orders.
ACKNOWLEDGE_HIGH_LEVERAGE_RISK=false
ACKNOWLEDGE_LIVE_TRADING=false
