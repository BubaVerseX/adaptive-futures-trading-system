# Bybit Unified Trading API V5 credentials.
# Create API keys in testnet first. Never commit a populated .env file.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
# Bybit Demo Trading is separate from testnet. Use npm run demo with BYBIT_DEMO_TRADING=true and BYBIT_TESTNET=false.
BYBIT_DEMO_TRADING=false
ACKNOWLEDGE_DEMO_TRADING=false
LIVE_VALIDATION_MODE=false
ACKNOWLEDGE_LIVE_VALIDATION_RISK=false
LIVE_VALIDATION_MAX_ALLOCATED_EQUITY_USDT=10
LIVE_VALIDATION_PROMOTION_ENABLED=true
LIVE_VALIDATION_PROTECTION_DRAWDOWN_PCT=15
LIVE_VALIDATION_REDUCED_RISK_MULTIPLIER=0.60
LIVE_VALIDATION_MAX_FEE_TO_GROSS_PROFIT_RATIO=0.65
LIVE_VALIDATION_REDUCED_FEE_DRAG_RATIO=0.80
LIVE_VALIDATION_MAX_PROMOTION_DRAWDOWN_PCT=15
LIVE_VALIDATION_EXPLORATION_RISK_AT_STOP_MAX_PCT=0.20
LIVE_VALIDATION_NORMAL_RISK_AT_STOP_MAX_PCT=0.35
LIVE_VALIDATION_STRONG_RISK_AT_STOP_MAX_PCT=0.50
LIVE_VALIDATION_ELITE_RISK_AT_STOP_MAX_PCT=0.75
# Leave blank to use the standard endpoint selected by BYBIT_DEMO_TRADING / BYBIT_TESTNET.
# Mainnet accounts registered in a regional Bybit site may require its official regional API URLs.
BYBIT_REST_BASE_URL=
BYBIT_WS_BASE_URL=
BYBIT_PUBLIC_WS_BASE_URL=
BYBIT_PRIVATE_WS_BASE_URL=
BYBIT_RECV_WINDOW_MS=5000

# Orders are simulated unless DRY_RUN is explicitly false.
DRY_RUN=true
ACCOUNT_START_USDT=100
X10_MODE=true

# Full learning phase keeps the bot active so adaptive memory gets real feedback.
LEARNING_PHASE_MODE=true
AGGRESSIVE_LEARNING_PHASE=true
HIGH_ACTIVITY_MODE=true
CONTINUOUS_EXECUTION_MODE=true
DISABLE_DAILY_TRADE_LIMITS=true
FORCED_MARKET_SAMPLING_ENABLED=true
FORCED_MARKET_SAMPLING_AFTER_MINUTES=4
FORCED_SAMPLING_MAX_CANDIDATES=3
FORCED_SAMPLING_MIN_SCORE=26
FORCED_SAMPLING_MIN_CONVICTION=32
FORCED_SAMPLING_MIN_PROJECTED_EDGE_PCT=0.10
FORCED_SAMPLING_MIN_EDGE_TO_COST_RATIO=1.15

# Active learning momentum strategy.
FAST_MODE=true
FOMO_BREAKOUT_MODE=true
MICRO_BREAKOUT_ENTRIES=true
ALLOW_CHOPPY_MARKET=true
ALLOW_PARTIAL_SCAN_ENTRIES=true
ALLOW_LONGS=true
ALLOW_SHORTS=true
MIN_SIGNAL_SCORE=42
AGGRESSIVE_SCORE_THRESHOLD=72

# Exposure and fee efficiency. Daily shutdown/loss stops are intentionally removed for 24/7 continuous execution.
MAX_OPEN_POSITIONS=3
# Ignored because continuous execution mode disables daily trade-count limits.
MAX_TRADES_PER_DAY=40
BASE_RISK_PER_TRADE_PCT=4
AGGRESSIVE_RISK_PER_TRADE_PCT=8
MAX_LEVERAGE=8
SET_LEVERAGE_ON_ENTRY=true
MAX_POSITION_NOTIONAL_USDT=150
MAX_MARGIN_USAGE_PCT=55
MAX_TOTAL_MARGIN_USAGE_PCT=90
MIN_LIQUIDATION_BUFFER_PCT=2
ESTIMATED_FEE_PCT_PER_SIDE=0.055
MAKER_FEE_PCT_PER_SIDE=0.020
TAKER_FEE_PCT_PER_SIDE=0.055
ESTIMATED_SLIPPAGE_PCT=0.08
ESTIMATED_FUNDING_PCT=0
MIN_PROJECTED_EDGE_PCT=0.55
MIN_EXPECTED_MOVE_PCT=0.95
EXPECTED_MOVE_ATR_MULTIPLIER=1.15
MIN_EDGE_TO_COST_RATIO=1.80
MIN_CONVICTION_SCORE=50
SMART_EDGE_MIN_NET_PCT=0.22
SMART_EDGE_MIN_TP_PROBABILITY=0.46
SMART_EDGE_COST_BUFFER_MULTIPLIER=1.25
EDGE_EXPLORATION_MIN_NET_PCT=0.06
EDGE_NORMAL_MIN_NET_PCT=0.14
EDGE_STRONG_MIN_NET_PCT=0.24
EDGE_ELITE_MIN_NET_PCT=0.36
EDGE_EXPLORATION_MIN_REWARD_COST_RATIO=1.20
EDGE_NORMAL_MIN_REWARD_COST_RATIO=1.55
EDGE_STRONG_MIN_REWARD_COST_RATIO=1.90
EDGE_ELITE_MIN_REWARD_COST_RATIO=2.35
EDGE_EXPLORATION_MIN_REWARD_RISK_RATIO=1.05
EDGE_NORMAL_MIN_REWARD_RISK_RATIO=1.25
EDGE_STRONG_MIN_REWARD_RISK_RATIO=1.45
EDGE_ELITE_MIN_REWARD_RISK_RATIO=1.65
ELITE_TREND_RIDER_ENABLED=true
ELITE_PARTIAL_TAKE_PROFIT_PCT=50
ELITE_RUNNER_TAKE_PROFIT_MULTIPLIER=1.55
ELITE_RUNNER_TRAILING_DISTANCE_MULTIPLIER=1.18
ELITE_MIN_SCORE=78
ELITE_MIN_CONVICTION_SCORE=72
ELITE_MIN_PROJECTED_EDGE_PCT=0.80
ELITE_MIN_FEE_EDGE_RATIO=2.20
ELITE_MIN_VOLUME_SPIKE=1.65
ELITE_MIN_TREND_QUALITY=68
ELITE_MIN_MOMENTUM_PERSISTENCE_CANDLES=2
SMART_REENTRY_WINDOW_MINUTES=35
CONTINUATION_ENGINE_ENABLED=true
CONTINUATION_MIN_STRENGTH=58
PULLBACK_CONTINUATION_ENABLED=true
RETEST_ENTRY_ENABLED=true
MOMENTUM_RESUMPTION_ENABLED=true
TREND_ACCELERATION_ENABLED=true
MACRO_TREND_WEIGHT=5
SYMBOL_SPECIALIZATION_ENABLED=true
SESSION_AGGRESSION_ENABLED=true
TIER1_MARGIN_MIN_USDT=2
TIER1_MARGIN_MAX_USDT=4
TIER2_MARGIN_MIN_USDT=5
TIER2_MARGIN_MAX_USDT=10
TIER3_MARGIN_MIN_USDT=12
TIER3_MARGIN_MAX_USDT=25
EXPLORATION_RISK_AT_STOP_MIN_PCT=0.20
EXPLORATION_RISK_AT_STOP_MAX_PCT=0.35
NORMAL_RISK_AT_STOP_MIN_PCT=0.40
NORMAL_RISK_AT_STOP_MAX_PCT=0.60
STRONG_RISK_AT_STOP_MIN_PCT=0.65
STRONG_RISK_AT_STOP_MAX_PCT=0.90
ELITE_RISK_AT_STOP_MIN_PCT=0.90
ELITE_RISK_AT_STOP_MAX_PCT=1.25
PORTFOLIO_MAX_OPEN_RISK_PCT=2.60
PORTFOLIO_EXPLOSIVE_MAX_OPEN_RISK_PCT=3.50
CORRELATED_CLUSTER_RISK_MULTIPLIER=0.72
FLIP_CONFIRMATION_MIN_STRENGTH=76
FLIP_MIN_NET_EDGE_PCT=0.28
OPPORTUNITY_CAPTURE_MODE=true
ENABLE_POST_ONLY_ENTRIES=false
POST_ONLY_MAX_WAIT_MS=4000
BREAKEVEN_COST_CUSHION_PCT=0.08
QUALITY_PACING_ENABLED=true
QUALITY_PACING_MIN_WIN_RATE_PCT=25
QUALITY_PACING_FEE_DRAG_RATIO=0.65
QUALITY_PACING_MIN_AVERAGE_HOLD_SECONDS=45
QUALITY_PACING_SIGNAL_ADJUSTMENT=4
QUALITY_PACING_EXPLORATION_ADJUSTMENT=3
QUALITY_PACING_EDGE_MULTIPLIER=1.25
QUALITY_PACING_RISK_MULTIPLIER=0.85
SYMBOL_LOSS_COOLDOWN_MINUTES=30
SYMBOL_REENTRY_COOLDOWN_SECONDS=180
EXPLORATION_MODE_ENABLED=true
EXPLORATION_TRADE_RATIO=0.55
EXPLORATION_MIN_SIGNAL_SCORE=28
EXPLORATION_MIN_CONVICTION_SCORE=34
EXPLORATION_MIN_PROJECTED_EDGE_PCT=0.16
EXPLORATION_MIN_EDGE_TO_COST_RATIO=1.20
EXPLORATION_RISK_MULTIPLIER=0.35
EXPLORATION_MAX_CHOP_SCORE=6
# Ignored when DISABLE_DAILY_TRADE_LIMITS=true.
EXPLORATION_MAX_TRADES_PER_DAY=999999

# Advanced market-regime intelligence and profit protection.
MARKET_REGIME_INTELLIGENCE_ENABLED=true
REGIME_STRONG_TREND_SCORE=55
REGIME_CHOP_SENSITIVITY=0.82
REGIME_HIGH_VOLATILITY_ATR_PCT=0.70
REGIME_LOW_LIQUIDITY_VOLUME_SPIKE=0.65
REGIME_DEAD_MARKET_ATR_PCT=0.10
REGIME_DEAD_MARKET_VOLUME_SPIKE=0.50
REGIME_FAKE_BREAKOUT_RANGE_EXPANSION=1.65
REGIME_MEMORY_WEIGHT=0.18
PROFIT_PROTECTION_ENABLED=true
PROFIT_PROTECTION_START_PCT=8
PROFIT_PROTECTION_RISK_MULTIPLIER=0.75
PROFIT_PROTECTION_EXPLORATION_MULTIPLIER=0.50
PROFIT_PROTECTION_SIGNAL_ADJUSTMENT=2
ADAPTIVE_ACTIVITY_FLOOR_ENABLED=true
ACTIVITY_FLOOR_MIN_TRADES_PER_DAY=18
ACTIVITY_FLOOR_MIN_EXPLORATION_BUDGET=4
ACTIVITY_FLOOR_SIGNAL_RELAX_POINTS=3
ACTIVITY_FLOOR_CONVICTION_RELAX_POINTS=4
ACTIVITY_FLOOR_CHOP_TOLERANCE_BONUS=1

# Bybit linear position mode. Set BYBIT_ENSURE_POSITION_MODE=true only if the bot may request this mode for USDT contracts.
BYBIT_POSITION_MODE=ONE_WAY
BYBIT_ENSURE_POSITION_MODE=false

# Fast scanner and REST/WebSocket recovery behavior.
SCAN_INTERVAL_MS=1200
POSITION_MONITOR_INTERVAL_MS=1200
ENTRY_CONFIRMATION_TIMEOUT_MS=15000
SCAN_CONCURRENCY=4
MARKET_REGIME_CACHE_MS=45000
API_REQUEST_INTERVAL_MS=70
API_RATE_LIMIT_COOLDOWN_MS=10000
API_AUTO_RECOVERY_ENABLED=true
API_RECOVERY_BASE_BACKOFF_MS=1000
API_RECOVERY_MAX_BACKOFF_MS=30000
WS_RECONNECT_BASE_MS=1000
CANDLE_INTERVAL_FAST=1M
CANDLE_INTERVAL_MAIN=5M
CANDLE_INTERVAL_TREND=15M
CANDLE_INTERVAL_MACRO=60M
# The executable trading universe is fixed to BTCUSDT, ETHUSDT, and SOLUSDT.
MAX_SYMBOLS_TO_SCAN=3
MIN_24H_VOLUME_USDT=1000000
MAX_SPREAD_PCT=0.60
EXCLUDED_SYMBOLS=
MIN_VOLUME_SPIKE=1.18
MIN_BURST_MOMENTUM_PCT=0.08
FOMO_MOMENTUM_PCT=0.18
MIN_MOMENTUM_PERSISTENCE_CANDLES=2
BTC_TREND_ALIGNMENT_BONUS=12
CHOPPY_MARKET_PENALTY=10
LOW_LIQUIDITY_SPIKE_PENALTY=16
ANTI_CHOP_ENABLED=true
MAX_CHOP_SCORE=3
MIN_RANGE_EXPANSION=0.72
MIN_DIRECTIONAL_BODY_STRENGTH=0.45
MIN_LIQUIDITY_SCORE=45

# Adaptive statistical learning. No neural networks, no cloud, only local JSON memory.
ADAPTIVE_LEARNING_ENABLED=true
MIN_ADAPTIVE_TRADES=5
MIN_ADAPTIVE_BUCKET_TRADES=2
ADAPTIVE_MEMORY_MAX_TRADES=5000
DEFENSIVE_WIN_RATE_PCT=32
AGGRESSIVE_WIN_RATE_PCT=55
ADAPTIVE_RECOVERY_WIN_RATE_PCT=40
ADAPTIVE_RECOVERY_LOOKBACK_TRADES=6
ADAPTIVE_CONFIDENCE_BONUS_MAX=12
ADAPTIVE_CONFIDENCE_PENALTY_MAX=10
ADAPTIVE_CONFIDENCE_FLOOR=22
ADAPTIVE_PENALTY_SCALE=0.55
ADAPTIVE_SMALL_SAMPLE_FULL_WEIGHT_TRADES=120
ADAPTIVE_SMALL_SAMPLE_MIN_WEIGHT=0.20
EXPLORATION_MEMORY_PENALTY_MULTIPLIER=0.45
ADAPTIVE_BLACKLIST_SCORE_PENALTY=8
TECHNICAL_OVERRIDE_ENABLED=true
TECHNICAL_OVERRIDE_MIN_CONVICTION=76
TECHNICAL_OVERRIDE_MIN_FEE_EDGE_RATIO=2.60
TECHNICAL_OVERRIDE_MIN_PROJECTED_EDGE_PCT=0.85
TECHNICAL_OVERRIDE_MIN_VOLUME_SPIKE=1.80
ADAPTIVE_BLACKLIST_WIN_RATE_PCT=20
ADAPTIVE_BLACKLIST_MINUTES=20
ADAPTIVE_RISK_MIN_MULTIPLIER=0.50
ADAPTIVE_RISK_MAX_MULTIPLIER=1.30
HIGH_VOLATILITY_ATR_PCT=0.80
ABNORMAL_VOLATILITY_ATR_PCT=1.60
LOW_VOLUME_MULTIPLE=4
MIN_HOLD_SECONDS_BEFORE_MOMENTUM_EXIT=180
CONTINUATION_MIN_SCORE=62
CONTINUATION_MIN_PNL_PCT=0.35

# Native Bybit take-profit/stop-loss plus optional native trailing stop.
TAKE_PROFIT_PCT=2.10
STOP_LOSS_PCT=0.80
TRAILING_STOP_ENABLED=true
TRAILING_START_PCT=1.10
TRAILING_DISTANCE_PCT=0.60

# Shutdown and notifications. MAX_CONSECUTIVE_API_ERRORS now escalates recovery stages; it does not shut the bot down.
EMERGENCY_STOP_FILE=STOP_BOT.txt
CLOSE_POSITION_ON_EXIT=true
MAX_CONSECUTIVE_API_ERRORS=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required acknowledgements when intentionally sending leveraged or mainnet orders.
ACKNOWLEDGE_HIGH_LEVERAGE_RISK=false
ACKNOWLEDGE_LIVE_TRADING=false
